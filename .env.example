# Copy this file to .env for LOCAL development only and fill in your own
# values. .env is ignored by git, so it is never committed.
# On a hosting platform, set these as environment variables / secrets in
# the platform's dashboard instead; wsgi.py does not read .env.
# Every value below is a placeholder, not a working credential.

# development (default) or production. In production the app refuses to
# start unless SECRET_KEY, DB_USER (not root) and DB_PASSWORD are set.
APP_ENV=development

DB_HOST=localhost
DB_PORT=3306
# Local development: the labadmin account from README section 5.
# Production: the data-only runtime account smartlab_app
# (sql/14_db_accounts.sql.example, docs/DEPLOYMENT.md).
DB_USER=labadmin
DB_PASSWORD=replace-with-your-own-password
DB_NAME=smart_lab_equipment_db
# Hosted MySQL that requires TLS: path to the provider's CA certificate.
DB_SSL_CA=

# Long random string used to sign the session cookie (required in production).
# Generate one with:  python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Behind the host's HTTPS proxy/load balancer set TRUST_PROXY=1 so the app
# sees the real client address and scheme. Leave 0 when running directly.
TRUST_PROXY=0
# Cookies are HTTPS-only in production. For local http://127.0.0.1 testing
# of APP_ENV=production you would need HTTPS; do not disable this on a server.
# COOKIE_SECURE=1

# Optional: make the app behave as if today were this date, so the
# demonstration matches the sample data. Remove the line for real use.
APP_REFERENCE_DATE=2026-10-10
