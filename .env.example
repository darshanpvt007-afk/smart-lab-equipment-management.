# Copy this file to .env and fill in your own values.
# .env is ignored by git, so your password is never committed.

DB_HOST=localhost
DB_PORT=3306
DB_USER=labadmin
DB_PASSWORD=change-me
DB_NAME=smart_lab_equipment_db

# Long random string used to sign the session cookie.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Optional: make the app behave as if today were this date, so the
# demonstration matches the sample data. Remove the line for real use.
APP_REFERENCE_DATE=2026-10-10
